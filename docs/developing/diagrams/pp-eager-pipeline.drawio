<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="pp-eager" name="eager pull">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Eager pull: the owner files what it serves; the reader asks once the value is produced and blocks on the reply" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="s0" value="Stage 0 (layers 0..11, embeddings)" style="swimlane;horizontal=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="600" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="s0_fwd" value="forward thread&#xa;module controller → Interleaver.handle → Mediator.handle&#xa;serves a LOCAL visit to the worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s0">
          <mxGeometry x="20" y="50" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s0_worker" value="worker greenlet (the block)&#xa;parks on its next location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="s0">
          <mxGeometry x="320" y="50" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s0_served" value="served() seam&#xa;local location → host copy → file(request, worker, provider, k)&#xa;answers requests already held for that key; then chase()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="s0">
          <mxGeometry x="20" y="170" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s0_buffer" value="serving buffer&#xa;key → value + countdown of peers that have not asked&#xa;held requests: key → [(peer, id, step)]&#xa;dropped when every stage has released the request" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s0">
          <mxGeometry x="20" y="300" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s0_recv" value="receive thread (per peer)&#xa;PULL request → answer from the buffer, or hold, or refuse&#xa;(worker failed here, or rounds finished past the step)&#xa;PARAM / CACHE request → answer; RELEASE → countdown; REPLY → wake the asker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s0">
          <mxGeometry x="20" y="470" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s0_sender" value="sender thread (per peer)&#xa;requests out, replies out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s0">
          <mxGeometry x="20" y="620" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s0_serve" value="serve points + chase (forward thread)&#xa;worker parked on another stage's value and the value produced?&#xa;→ pull(owner, request, worker, provider, k, step): send request, block on reply&#xa;→ switch(value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s0">
          <mxGeometry x="320" y="170" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s0_shell" value="RemoteShell (layers 12..23, norm, head)&#xa;.output read → ordinary park&#xa;param() / call → PARAM request → kept per engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="s0">
          <mxGeometry x="320" y="330" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s0_rounds" value="round_done(request, rounds) at sampling: local only, no marker on the wire;&#xa;held requests for earlier steps are refused &quot;ran past&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="s0">
          <mxGeometry x="320" y="470" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s0_note" value="Every value crossed = one request + one reply (three gloo messages) per reader worker; the reply waits on the owner's receive thread. Stage 0's read of layer 20 waits until its next step start, then blocks on the round trip." style="text;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="s0">
          <mxGeometry x="20" y="700" width="560" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="Stage 1 (layers 12..23, norm, head, sampler)" style="swimlane;horizontal=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="600" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="s1_fwd" value="forward thread → serves local visits, logits, samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s1">
          <mxGeometry x="20" y="50" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1_worker" value="worker greenlet (the same block)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="s1">
          <mxGeometry x="320" y="50" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1_served" value="served() → file(...) → answer held requests; chase()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="s1">
          <mxGeometry x="20" y="170" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s1_buffer" value="serving buffer + held requests" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s1">
          <mxGeometry x="20" y="300" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s1_recv" value="receive thread → answer / hold / refuse; replies in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s1">
          <mxGeometry x="20" y="470" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s1_sender" value="sender thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s1">
          <mxGeometry x="20" y="620" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1_serve" value="chase in place: stage 0's value of the round being run is produced → pull now, inside the forward, before the later layers pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s1">
          <mxGeometry x="320" y="170" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s1_shell" value="RemoteShell (layers 0..11, embeddings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="s1">
          <mxGeometry x="320" y="330" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_fwd" target="s0_worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_fwd" target="s0_served"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_served" target="s0_buffer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_recv" target="s0_buffer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_serve" target="s0_sender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_serve" target="s0_worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="s0" source="s0_recv" target="s0_serve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7l" value="reply wakes the blocked pull" style="text;html=1;fontSize=10;" vertex="1" parent="s0"><mxGeometry x="300" y="440" width="150" height="20" as="geometry"/></mxCell>

        <mxCell id="f1" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_fwd" target="s1_worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_fwd" target="s1_served"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_served" target="s1_buffer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_recv" target="s1_buffer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_serve" target="s1_sender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_serve" target="s1_worker"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="x1" value="PULL(request, worker, layer 20, k, step) →" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s0_sender" target="s1_recv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x2" value="← REPLY(value) / refusal;  PULL(layer 2) ←;  RELEASE(request)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s1_sender" target="s0_recv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x3" value="vLLM's own pipeline: intermediate tensors (NCCL), sampled ids back through the engine core" style="endArrow=classic;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="s0_fwd" target="s1_fwd"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
