<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="pp-push" name="push">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Push: the owner sends what it serves; the reader takes from an inbox, in request order" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>

        <!-- Stage 0 -->
        <mxCell id="s0" value="Stage 0 (layers 0..11, embeddings)" style="swimlane;horizontal=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="600" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="s0_fwd" value="forward thread&#xa;module controller → Interleaver.handle → Mediator.handle&#xa;serves a LOCAL visit to the worker (narrowed, gathered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s0">
          <mxGeometry x="20" y="50" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s0_worker" value="worker greenlet (the block)&#xa;runs to its next read, parks on a location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="s0">
          <mxGeometry x="320" y="50" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s0_served" value="served() seam&#xa;local location → copy value to host (forward thread) → outbound queue&#xa;then chase(): answer the worker's next remote request if produced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="s0">
          <mxGeometry x="20" y="170" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s0_sender" value="sender thread (per peer)&#xa;encode: pickle + tensor bytes → gloo send header, blob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s0">
          <mxGeometry x="20" y="300" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s0_recv" value="receive thread (per peer)&#xa;gloo recv header, blob → decode → file&#xa;VALUE / CACHE → inbox[(request, worker)][provider]&#xa;ROUND → done rounds; ERROR → refusal; PARAM request → resolver → reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s0">
          <mxGeometry x="20" y="410" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s0_inbox" value="inbox&#xa;(request, worker) → provider → FIFO of values" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s0">
          <mxGeometry x="330" y="400" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s0_serve" value="serve points (forward thread)&#xa;step start: take values of finished rounds → switch(value)&#xa;collect: take the last round → wind up&#xa;sample: rounds += 1, send ROUND marker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s0">
          <mxGeometry x="320" y="170" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s0_shell" value="RemoteShell (layers 12..23, norm, head)&#xa;.output read → ordinary park&#xa;param() / call → PARAM request → kept per engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="s0">
          <mxGeometry x="320" y="300" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s0_note" value="Stage 0's worker reads layer 20 (stage 1's): parks. Stage 1 serves layer 20 to its own worker → pushes it. Stage 0 takes it at its next step start (round produced) or at collect." style="text;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="s0">
          <mxGeometry x="20" y="560" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s0_note2" value="Stage 1's worker reads layer 2 (stage 0's): stage 0 pushed it during its forward, before the intermediate tensors; stage 1 takes it in place, inside its own forward, without parking past its later layers." style="text;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="s0">
          <mxGeometry x="20" y="640" width="560" height="60" as="geometry"/>
        </mxCell>

        <!-- Stage 1 -->
        <mxCell id="s1" value="Stage 1 (layers 12..23, norm, head, sampler)" style="swimlane;horizontal=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="600" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="s1_fwd" value="forward thread&#xa;module controller → Interleaver.handle → Mediator.handle&#xa;logits and samples served the same way at sampling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s1">
          <mxGeometry x="20" y="50" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1_worker" value="worker greenlet (the same block)&#xa;same requests, same order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="s1">
          <mxGeometry x="320" y="50" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1_served" value="served() seam&#xa;host copy → outbound queue; chase()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="s1">
          <mxGeometry x="20" y="170" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s1_sender" value="sender thread → gloo send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s1">
          <mxGeometry x="20" y="300" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s1_recv" value="receive thread → decode → inbox / done / refusal / reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="s1">
          <mxGeometry x="20" y="410" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s1_inbox" value="inbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s1">
          <mxGeometry x="330" y="400" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s1_serve" value="serve points + in-place take (chase)&#xa;an earlier stage's value of the round being run is taken inside the forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s1">
          <mxGeometry x="320" y="170" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s1_shell" value="RemoteShell (layers 0..11, embeddings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="s1">
          <mxGeometry x="320" y="300" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- intra-stage edges (stage 0) -->
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_fwd" target="s0_worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1l" value="serve / park" style="text;html=1;fontSize=10;" vertex="1" parent="s0"><mxGeometry x="285" y="75" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_fwd" target="s0_served"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_served" target="s0_sender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_recv" target="s0_inbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_inbox" target="s0_serve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="s0" source="s0_serve" target="s0_worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="s0" source="s0_shell" target="s0_sender"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- intra-stage edges (stage 1) -->
        <mxCell id="f1" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_fwd" target="s1_worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_fwd" target="s1_served"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_served" target="s1_sender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_recv" target="s1_inbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_inbox" target="s1_serve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" style="endArrow=classic;html=1;" edge="1" parent="s1" source="s1_serve" target="s1_worker"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- cross-stage edges -->
        <mxCell id="x1" value="VALUE (layer 2 @ round n), CACHE, ROUND, ERROR, PARAM reply&#xa;one header + one blob per item, gloo" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s0_sender" target="s1_recv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x2" value="VALUE (layer 20 @ round n, logits @ round n), ROUND, PARAM reply" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s1_sender" target="s0_recv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x3" value="vLLM's own pipeline: intermediate tensors (NCCL), sampled ids back through the engine core" style="endArrow=classic;html=1;dashed=1;strokeColor=#666666;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="s0_fwd" target="s1_fwd"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
